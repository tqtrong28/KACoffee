APP_NAME=KACoffee API
DEBUG=true
DATABASE_SOCKET=/tmp/mysql.sock
DATABASE_HOST=127.0.0.1
DATABASE_PORT=3306
DATABASE_NAME=kacoffee
DATABASE_USER=root
DATABASE_PASSWORD=replace-with-your-local-mysql-password
DATABASE_CHARSET=utf8mb4
# If DATABASE_SOCKET is set, the app will connect through the local MySQL socket
# and ignore TCP host/port. Remove DATABASE_SOCKET if your MySQL actually listens
# on 127.0.0.1:3306 and you prefer pure TCP/IP.
# Optional: override the full SQLAlchemy URL directly if needed.
# DATABASE_URL=mysql+pymysql://root:your-password@localhost/kacoffee?unix_socket=%2Ftmp%2Fmysql.sock&charset=utf8mb4
AUTO_INIT_DB_ON_STARTUP=false
AUTO_SEED_ON_STARTUP=false
RUN_LEGACY_COMPAT_MIGRATIONS=false
JWT_SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=14
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=admin123
